# ── Application ─────────────────────────────────────────────────
APP_ID=                    # Identifiant d'application (obligatoire en production)
APP_SECRET=                # Secret d'application (obligatoire en production)

# ── Base de données (Neon / PostgreSQL) ─────────────────────────
DATABASE_URL=              # postgresql://user:pass@host/db?sslmode=require

# ── Stockage des images (Cloudflare R2, API compatible S3) ───────
# Photos produits/galerie (publiques) et captures d'écran D17 (privées,
# servies uniquement à l'admin). Sans ces variables, l'upload est refusé
# avec un message clair mais le reste du site fonctionne.
R2_ACCOUNT_ID=             # Identifiant de compte Cloudflare
R2_ACCESS_KEY_ID=          # Jeton R2 : permission "Object Read & Write" sur le bucket
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                 # Nom exact du bucket (ex. chezlaziz)

# ── Notification e-mail des nouvelles commandes (optionnel) ──────
# Via l'API Resend (https://resend.com). Sans ces variables, aucune
# notification n'est envoyée — la commande est quand même enregistrée.
RESEND_API_KEY=
EMAIL_FROM=                # ex. "Chez Laziz <commandes@chezlaziz.com>" (domaine vérifié chez Resend)
ADMIN_NOTIFY_EMAIL=        # ex. contact@chezlaziz.com

# ── Google Analytics 4 (optionnel, côté navigateur) ──────────────
# Sans identifiant, aucun script Google n'est chargé.
VITE_GA_MEASUREMENT_ID=    # ex. G-XXXXXXXXXX
